# Скопируйте в .env и задайте реальные значения. Никогда не коммитьте .env.

# Обязательный секрет для подписи JWT (>= 32 символа).
# Генерация: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-strong-random-value

# PostgreSQL (async-driver). Формат совместим с SQLAlchemy 2.0.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app

# Отключить пул соединений (NullPool). Включайте для тестов и serverless-сред,
# где соединение нельзя переиспользовать между event loop'ами.
DATABASE_POOL_DISABLED=false

# Окружение: development | staging | production
ENVIRONMENT=development
DEBUG=false

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# CORS — перечислить разрешённые origins через запятую
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute

# Логирование
LOG_LEVEL=INFO
LOG_JSON=true